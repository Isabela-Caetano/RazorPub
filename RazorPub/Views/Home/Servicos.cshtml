@{
    ViewData["Title"] =
        "Serviços de Barbearia e Prótese Capilar em Interlagos";

    ViewData["Description"] =
        "Conheça os serviços de barbearia e solicite uma avaliação para prótese capilar na Razor Pub Barbearia em Interlagos.";
}

<section class="services-page">
    <div class="services-header">
        <p class="eyebrow">SERVIÇOS</p>

        <h1>SERVIÇOS DE BARBEARIA EM INTERLAGOS</h1>

        <p>
            Cortes, barba e cuidados pensados para você sair com mais estilo
            e confiança.
        </p>
    </div>

    <div class="services-layout">
        <div class="services-list">
            <article class="service-list-item">
                <div>
                    <h2>CORTE MASCULINO MASTER</h2>
                    <p>Corte personalizado com acabamento premium.</p>
                </div>

                <span class="service-price">R$ 70</span>
            </article>

            <article class="service-list-item">
                <div>
                    <h2>BARBA</h2>
                    <p>Ritual completo com toalha quente e navalha.</p>
                </div>

                <span class="service-price">R$ 60</span>
            </article>

            <article class="service-list-item">
                <div>
                    <h2>CORTE + BARBA</h2>
                    <p>A experiência completa do cavalheiro.</p>
                </div>

                <span class="service-price">R$ 120</span>
            </article>

            <article class="service-list-item">
                <div>
                    <h2>SOBRANCELHAS</h2>
                    <p>Design masculino preciso e discreto.</p>
                </div>

                <span class="service-price">R$ 25</span>
            </article>

            <article class="service-list-item">
                <div>
                    <h2>SELAGEM</h2>
                    <p>Tratamento de hidratação e alinhamento.</p>
                </div>

                <span class="service-price">R$ 180</span>
            </article>

            <article class="service-list-item">
                <div>
                    <h2>PEZINHO / ACABAMENTO</h2>
                    <p>Finalização e contorno impecável.</p>
                </div>

                <span class="service-price">R$ 35</span>
            </article>
        </div>

        <a class="prosthesis-feature"
           href="https://wa.me/5511916599253?text=Oi%2C%20tenho%20interesse%20em%20agendar%20um%20horario"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Falar no WhatsApp sobre prótese capilar">
            <img src="~/imagens/protesecapilar.png"
                 alt="Antes e depois de prótese capilar na Razor Pub" />

            <div class="prosthesis-feature-content">
                <p class="eyebrow">NOVIDADE NA RAZOR PUB</p>

                <h2>PRÓTESE CAPILAR</h2>

                <p>
                    Realce sua imagem com uma avaliação personalizada,
                    discrição e resultado pensado para você.
                </p>

                <span class="prosthesis-feature-action">
                    SOLICITE UM ORÇAMENTO <span>→</span>
                </span>
            </div>
        </a>
    </div>

    <section class="page-cta">
        <p>PRONTO PARA CUIDAR DO SEU ESTILO?</p>

        <div>
            <a class="button button-light"
               href="https://wa.me/5511916599253?text=Oi%2C%20tenho%20interesse%20em%20agendar%20um%20horario"
               target="_blank"
               rel="noopener noreferrer">
                AGENDAR HORÁRIO
            </a>

            <a class="button"
               asp-controller="Home"
               asp-action="Espaco">
                CONHEÇA O ESPAÇO
            </a>

            <a class="button"
               asp-controller="Home"
               asp-action="Index">
                VOLTAR AO INÍCIO
            </a>
        </div>
    </section>
</section>